    "license": "GPL-3.0+",
    "authors": [
        {
            "name": "Henning Leutz",
            "email": "support@pcsg.de",
            "homepage": "https://www.pcsg.de",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@pcsg.de"
    },
    "require": {
        "quiqqer/core": "^2",
        "quiqqer/bricks": "^2"
    },
    "autoload": {
        "psr-4": {
            "QUI\\SiteTypes\\": "src/QUI/SiteTypes",
            "QUI\\Controls\\": "src/QUI/Controls"
        }
    }
}